{
  "name": "nest-lab",
  "private": true,
  "version": "0.0.0",
  "description": "NestJS monorepo — backends and experiments",
  "scripts": {
    "dev": "pnpm -r --parallel --if-present run start:dev",
    "build": "pnpm -r --if-present run build",
    "start": "pnpm -r --if-present run start",
    "test": "pnpm -r --if-present run test",
    "lint": "pnpm -r --if-present run lint",
    "format": "pnpm -r --if-present run format",
    "clean": "pnpm -r exec rm -rf node_modules dist && rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "catalog:"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
